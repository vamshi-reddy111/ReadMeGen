# Environment variables for README Auto Generator backend
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control - add it to .gitignore

# LLM API Key for calling external language model services
# Get your API key from your LLM provider (OpenAI, Anthropic, etc.)
# Example providers: https://platform.openai.com, https://console.anthropic.com
GEMINI_API_KEY=your_api_key_here
